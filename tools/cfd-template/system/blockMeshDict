// OpenFOAM v1912 case file (banner elided to avoid backslash-continuation)
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// Background box around the aircraft, padded 10 m from the model bbox.
// Boundary names: inlet (x-min, flow enters +x), outlet (x-max), top/bottom/front/back.
convertToMeters 1;

x0 -30.06; x1 30.06;
y0 -27.55; y1 27.55;
z0 -5.90;  z1 15.90;

vertices
(
    ( $x0 $y0 $z0 )   // 0
    ( $x1 $y0 $z0 )   // 1
    ( $x1 $y1 $z0 )   // 2
    ( $x0 $y1 $z0 )   // 3
    ( $x0 $y0 $z1 )   // 4
    ( $x1 $y0 $z1 )   // 5
    ( $x1 $y1 $z1 )   // 6
    ( $x0 $y1 $z1 )   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (30 30 10) simpleGrading (1 1 1)
);

edges ();

boundary
(
    inlet   { type patch;         faces ((0 3 7 4)); }   // x-min
    outlet  { type patch;         faces ((1 2 6 5)); }   // x-max
    back    { type symmetryPlane; faces ((0 1 5 4)); }   // y-min
    front   { type symmetryPlane; faces ((3 2 6 7)); }   // y-max
    bottom  { type symmetryPlane; faces ((0 1 2 3)); }   // z-min
    top     { type symmetryPlane; faces ((4 5 6 7)); }   // z-max
);

mergedPatchPairs ();
